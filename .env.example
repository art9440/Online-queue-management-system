# Copy to .env and fill in the secrets: cp .env.example .env
# Every service reads its configuration only from environment variables (12-factor III).
# Values marked "change me" are placeholders and must be replaced outside local development.

# --- PostgreSQL (container) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=online_queue_db

# --- PostgreSQL (clients: services and migrate) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=change-me
# Required, no default: disable | require | verify-full
DB_SSLMODE=disable
# Optional: full DSN overrides the DB_* values above
# DB_DSN=postgres://admin:change-me@postgres:5432/online_queue_db?sslmode=disable

# --- Redis ---
REDIS_ADDR=redis:6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# --- HTTP ports ---
REGISTRATION_PORT=8081
AUTH_PORT=8082
BRANCHES_PORT=8083
BOOKING_PORT=8084
BOT_PORT=8085

# Comma-separated browser origins allowed to call the APIs (CORS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173

# --- Auth (JWT in HTTP-only cookies) ---
JWT_ACCESS_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=168h
# true when served over HTTPS
COOKIE_SECURE=false

# --- Email (registration codes, password recovery, reminders) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
# For Gmail: an app password, not the account password
SMTP_PASS=change-me
EMAIL_TIMEOUT=20s

# --- Registration email queue ---
NUM_WORKERS=10
RATE_LIMIT=10s
WRK_TIMEOUT=30s
# "test" makes the registration code always 123456 (for e2e tests); leave empty otherwise
APP_ENV=

# --- Booking: calendar export ---
# Where the Google OAuth callback sends the user back
FRONTEND_URL=http://localhost:5173
# Optional. All three must be set to enable "save to Google Calendar automatically";
# .ics download works without them. Setup: see PUBLIC_BOOKING_API.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8084/google-calendar/callback

# --- Telegram bot ---
# Optional: empty token disables polling and sending, the service still starts
TELEGRAM_BOT_TOKEN=
TELEGRAM_POLLING_TIMEOUT=30
TELEGRAM_POLLING_INTERVAL=1s

# --- Scheduler (reminders by email and Telegram) ---
BOT_URL=http://bot:8085
SCHEDULER_POLL_INTERVAL=30s
SCHEDULER_BATCH_SIZE=100
